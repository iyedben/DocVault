# Copy to .env, replace every placeholder with a unique random secret, and chmod 600.
# Do not commit .env or reuse these placeholder values.
POSTGRES_PASSWORD=replace-with-random-bootstrap-superuser-password
POSTGRES_APP_USER=docvault_app
POSTGRES_APP_PASSWORD=replace-with-random-application-password
POSTGRES_MIGRATION_USER=docvault_migrator
POSTGRES_MIGRATION_PASSWORD=replace-with-random-migration-password
# Set true for HTTPS; false is for local HTTP development only.
AUTH_COOKIE_SECURE=false
